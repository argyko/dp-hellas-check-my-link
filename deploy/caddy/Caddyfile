{$DOMAIN} {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains" always
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        -Server
    }
    reverse_proxy frontend:3000
}
